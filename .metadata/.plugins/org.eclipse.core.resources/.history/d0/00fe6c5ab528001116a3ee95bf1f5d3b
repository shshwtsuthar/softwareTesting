public class DateUtilTest {

	private void assertDate(DateUtil date, int expectedDay, int expectedMonth, int expectedYear) {
		Assert.assertEquals(expectedDay, date.getDay());
		Assert.assertEquals(expectedMonth, date.getMonth());
		Assert.assertEquals(expectedYear, date.getYear());
	}

	private void assertIncrement(int day, int month, int year, int expectedDay, int expectedMonth, int expectedYear) {
		DateUtil date = new DateUtil(day, month, year);
		System.out.println("increment > " + date);
		date.increment();
		System.out.println(date);
		assertDate(date, expectedDay, expectedMonth, expectedYear);
	}

	private void assertDecrement(int day, int month, int year, int expectedDay, int expectedMonth, int expectedYear) {
		DateUtil date = new DateUtil(day, month, year);
		System.out.println("decrement > " + date);
		date.decrement();
		System.out.println(date);
		assertDate(date, expectedDay, expectedMonth, expectedYear);
	}

	@Test
	public void testStudentIdentity() {
		String studentId = "YOUR_STUDENT_ID";
		Assert.assertNotNull("Student ID is null", studentId);
		Assert.assertFalse("Student ID is empty", studentId.trim().isEmpty());
	}

	@Test
	public void testStudentName() {
		String studentName = "YOUR_FULL_NAME";
		Assert.assertNotNull("Student name is null", studentName);
		Assert.assertFalse("Student name is empty", studentName.trim().isEmpty());
	}

	@Test
	public void testMaxJanuary31ShouldIncrementToFebruary1() {
		assertIncrement(31, 1, 2024, 1, 2, 2024);
	}

	@Test
	public void testMaxJanuary31ShouldDecrementToJanuary30() {
		assertDecrement(31, 1, 2024, 30, 1, 2024);
	}

	@Test
	public void testNominalJanuary() {
		assertIncrement(15, 1, 2024, 16, 1, 2024);
	}

	@Test
	public void testMinJanuary1ShouldIncrementToJanuary2() {
		assertIncrement(1, 1, 2024, 2, 1, 2024);
	}

	@Test
	public void testMinJanuary1ShouldDecrementToDecember31() {
		assertDecrement(1, 1, 2024, 31, 12, 2023);
	}

